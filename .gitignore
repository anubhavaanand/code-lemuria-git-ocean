# Dependencies
node_modules
.pnpm-store

# Build output
dist
dist-ssr
.output

# Environment — never commit real credentials
.env
.env.local
.env.*.local
.dev.vars
# worker/.dev.vars.example IS committed: it documents the names without the values.
!worker/.dev.vars.example

# Cloudflare / wrangler local state
.wrangler
.mf
worker-configuration.d.ts

# Logs
*.log
npm-debug.log*
logs

# Editor / OS noise
.DS_Store
Thumbs.db
.idea
*.swp
*.swo
*~

# Local scratch — design chat exports, firecrawl captures, speckit tooling
context/
.firecrawl/
.dsh/
.specify/
.directory

# Reference clones — read-only upstream projects kept locally for study.
# GithubCity is here to learn how its world is made interactive; none of it is
# shipped, so it must never enter this repo's history.
.reference/

# Capture harness scratch — a headless Chrome profile and the frames it writes.
# They are QA input, not source: a profile is megabytes of cache, and a capture
# is a binary that says nothing a committed test does not.
.chrome-home/
.chrome-prof/
.tmp/

# Agent worktree scaffolding — sibling checkouts an agent creates under .claude/
# to work several branches at once. Each one is a full copy of this repository
# (src, dist, node_modules links), so committing it would duplicate the tree
# inside itself and recurse on every agent run.
.claude/
