# Git Ocean — Environment Configuration

# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# GitHub OAuth App — create one at https://github.com/settings/developers
#
# CLIENT_ID is public and belongs in the bundle; it is what the authorize URL
# carries. CLIENT_SECRET must never appear in this file or anywhere with a VITE_
# prefix — Vite inlines those into the browser bundle. The secret lives in the
# worker as a Cloudflare secret (see worker/.dev.vars.example).
VITE_GITHUB_CLIENT_ID=your_github_client_id_here

# App configuration
VITE_APP_NAME=Git Ocean
VITE_APP_VERSION=1.0.0
