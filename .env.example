# Git Ocean — Environment Configuration

# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# GitHub OAuth App — create one at https://github.com/settings/developers
VITE_GITHUB_CLIENT_ID=your_github_client_id_here
VITE_GITHUB_CLIENT_SECRET=your_github_client_secret_here

# Cloudflare (for Phase 2 deployment)
# VITE_CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
# VITE_CLOUDFLARE_API_TOKEN=your_cloudflare_api_token

# App configuration
VITE_APP_NAME=Git Ocean
VITE_APP_VERSION=1.0.0
